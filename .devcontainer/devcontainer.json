{
  "name": "Plane (self-hosted test)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [80],
  "portsAttributes": {
    "80": { "label": "Plane", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup-env.sh",
  "postStartCommand": "bash .devcontainer/start.sh"
}
